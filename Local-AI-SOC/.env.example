# AI-SOC Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it contains secrets.

# Ollama settings
OLLAMA_URL=http://localhost:11434/api/generate
MODEL_NAME=llama3.1:8b

# Threat intelligence enrichment
ENRICHMENT_ENABLED=true

# AbuseIPDB API key (optional — get a free key at https://www.abuseipdb.com/api)
# Leave empty to use only the local threat feed (fully offline mode)
ABUSEIPDB_API_KEY=

# Rate limit for AbuseIPDB free tier (1000 checks/day)
ABUSEIPDB_DAILY_LIMIT=1000
